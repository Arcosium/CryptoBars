[Unit]
Description=CryptoBars — 크립토 전 종목 1분봉 상시 수집기
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arcosium
Group=arcosium
WorkingDirectory=/home/arcosium/projects/CryptoBars
ExecStart=/home/arcosium/projects/CryptoBars/.venv/bin/python collector.py
# SIGTERM 을 받으면 버퍼를 flush 하고 종료한다(collector.py 의 시그널 핸들러).
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
